# ------------------------------------------------------------------
# AI-ARCTEG environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# Application
APP_NAME=AI-ARCTEG
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database — SQLite by default; set a PostgreSQL URL for production
DATABASE_URL=sqlite:///./data/arcteg.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/arcteg

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEFAULT_ADMIN_EMAIL=admin@arcteg.local
DEFAULT_ADMIN_PASSWORD=ChangeMe!123

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API
API_V1_PREFIX=/api/v1
RATE_LIMIT_PER_MINUTE=120

# MQTT (leave broker empty to disable hardware ingestion)
MQTT_BROKER_URL=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=ai-arcteg

# Hardware ingestion
DEVICE_INGEST_API_KEY=dev-ingest-key
HARDWARE_ONLINE_THRESHOLD_SECONDS=60

# Simulation / digital twin
SIMULATION_AUTOSTART=true
SIMULATION_TICK_SECONDS=5
SIMULATION_SPEED=1.0
SIMULATION_LATITUDE=23.8103
SIMULATION_LONGITUDE=90.4125
SIMULATION_DEFAULT_LOCATION=Dhaka

# Physics model parameters (documented simplified model)
PV_AREA_M2=0.5
CONCENTRATOR_AREA_M2=0.4
PV_EFFICIENCY=0.17
TEG_SEEBECK_V_PER_K=0.045
TEG_INTERNAL_RESISTANCE_OHM=3.2
CONCENTRATOR_GAIN_K=58.0

# ML
MODEL_PATH=./ml/models
MODEL_AUTOLOAD=true

# Weather provider (optional, configurable — never hardcode fake weather)
WEATHER_API_KEY=
WEATHER_API_PROVIDER=
WEATHER_API_BASE_URL=

# Frontend (build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
